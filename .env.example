PORT=3001

# Configure DATABASE_URL ou os campos PG* abaixo.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/total_battle_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=total_battle_db

# Para provedores PostgreSQL que exigem TLS:
# PGSSLMODE=require
# PGSSL_REJECT_UNAUTHORIZED=true
# PGPOOL_MAX=5

# Obrigatório no ambiente de produção para autorizar gravações de formações.
# Use uma chave longa e aleatória, diferente da senha do banco.
CATALOG_WRITE_TOKEN=
